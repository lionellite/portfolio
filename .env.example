# ──────────────────────────────────────────────────────────────────────────
# CONFIGURATION DU PORTFOLIO (LIONEL ADOUKONOU)
# ──────────────────────────────────────────────────────────────────────────

# Clé secrète Flask pour sécuriser la session utilisateur
SECRET_KEY=super-secret-key-change-it-in-prod

# Configuration de la base de données SQLite par défaut
DATABASE_URL=sqlite:///portfolio.db

# ── ESPACE ADMIN SECRET ──
# Route secrète d'accès à la page de connexion (ex: si ADMIN_LOGIN_ROUTE=ma-route-secrete, l'accès se fera sur /ma-route-secrete)
# Toute tentative d'accès à d'autres URLs d'administration (/admin/*) sans être connecté lèvera une erreur 404 (pour dissimuler l'espace admin)
ADMIN_LOGIN_ROUTE=lionel-login

# Identifiant administrateur
ADMIN_USER=lionel

# Mot de passe administrateur
ADMIN_PASSWORD=adoukonou2026
